{
  "schema": "jubelle.workflowprofile/1",
  "id": "musescore",
  "name": "MuseScore Studio",
  "description": "MuseScore Studio 4's menu arrangement and shortcuts. Jubelle's own commands are added to the nearest MuseScore menu.",
  "menus": [
    { "id": "menu-file", "title": "&File",
      "entries": ["file-new", "file-open", "menu-file-open", "file-close", "-",
                  "file-save", "file-save-as", "file-save-to-cloud", "menu-file-save-other", "menu-file-publish", "-",
                  "file-export", "*", "-", "project-properties", "parts", "-", "print", "-", "quit"],
      "takes": ["menu-jubelle-export", "menu-file"] },
    { "id": "menu-edit", "title": "&Edit",
      "entries": ["action://notation/undo", "action://notation/redo", "toggle-undo-history-panel", "-",
                  "action://notation/cut", "action://notation/copy", "action://notation/paste", "notation-paste-half",
                  "notation-paste-double", "notation-swap", "action://notation/delete", "-",
                  "notation-select-all", "notation-select-section", "find", "*", "-", "preference-dialog"],
      "takes": ["menu-edit"] },
    { "id": "menu-view", "title": "&View",
      "entries": ["fullscreen", "toggle-palettes", "masterpalette", "toggle-instruments", "inspector",
                  "toggle-selection-filter", "toggle-navigator", "toggle-braille-panel", "toggle-timeline", "toggle-mixer",
                  "toggle-piano-keyboard", "toggle-percussion-panel", "playback-setup", "-",
                  "menu-toolbars", "menu-workspaces", "-", "menu-show", "*", "-", "dock-restore-default-layout"],
      "takes": ["menu-view"] },
    { "id": "menu-add", "title": "&Add", "takes": ["menu-add"] },
    { "id": "menu-format", "title": "F&ormat",
      "entries": ["edit-style", "page-settings", "-", "measures-per-system", "menu-stretch", "-",
                  "reset-text-style-overrides", "reset-beammode", "reset", "reset-to-default-layout", "-",
                  "load-style", "save-style"],
      "takes": ["menu-format"] },
    { "id": "menu-tools", "title": "&Tools",
      "entries": ["menu-voices", "menu-tools-measures", "transpose", "-", "explode", "implode", "realize-chord-symbols", "-",
                  "slash-fill", "slash-rhythm", "-", "menu-enharmonic-spelling", "-", "reset-groupings",
                  "resequence-rehearsal-marks", "-", "copy-lyrics-to-clipboard", "del-empty-measures"],
      "takes": ["menu-tools", "menu-jubelle-playback"] },
    { "id": "menu-plugins", "title": "&Plugins", "takes": ["menu-plugins"] },
    { "id": "menu-help", "title": "&Help", "takes": ["menu-help"] }
  ],
  "behaviour": {
    "noteInputMethod": "BY_NOTE_NAME",
    "accidentalsApplyToNextNote": true,
    "noteInputCursorInInputByDuration": false,
    "selectionProximity": 2
  }
}
